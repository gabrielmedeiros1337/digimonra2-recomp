# Separate startup/storage/launcher layer. Frozen CPU/GX target options are unchanged.
set(DOLPHIN_EXTERNALS "${CMAKE_CURRENT_SOURCE_DIR}/ModernGekko-Template/lib/ModernGekko/vendor/dolphin/Externals")
function(dolphin_disable_warnings target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W0)
    endif()
endfunction()
add_subdirectory("${DOLPHIN_EXTERNALS}/bzip2" "${CMAKE_BINARY_DIR}/portable_codecs/bzip2" EXCLUDE_FROM_ALL)
add_subdirectory("${DOLPHIN_EXTERNALS}/liblzma" "${CMAKE_BINARY_DIR}/portable_codecs/lzma" EXCLUDE_FROM_ALL)
add_subdirectory("${DOLPHIN_EXTERNALS}/zstd" "${CMAKE_BINARY_DIR}/portable_codecs/zstd" EXCLUDE_FROM_ALL)
add_library(portable_support STATIC src_test/portable_config.cpp src_test/disc_image.cpp src_test/card_store.cpp)
target_include_directories(portable_support PRIVATE "${DOLPHIN_EXTERNALS}/picojson")
target_compile_definitions(portable_support PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
target_link_libraries(portable_support PUBLIC BZip2::BZip2 LibLZMA::LibLZMA zstd::zstd bcrypt)
if(MSVC)
    target_compile_options(portable_support PRIVATE /O2 /W3 /utf-8)
endif()
target_sources(digimon_test PRIVATE src_test/card_hle.c src_test/input_devices.c)
target_link_libraries(digimon_test PRIVATE portable_support shell32)
add_executable(DigimonRA2 WIN32 src_test/launcher.cpp src_test/input_devices.c)
target_compile_definitions(DigimonRA2 PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE _CRT_SECURE_NO_WARNINGS)
target_link_libraries(DigimonRA2 PRIVATE portable_support "${SDL2_DIR}/lib/x64/SDL2.lib" comdlg32 shell32 user32 gdi32)
if(MSVC)
    target_compile_options(DigimonRA2 PRIVATE /O2 /W3 /utf-8)
endif()
add_custom_command(TARGET DigimonRA2 POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${SDL2_DIR}/lib/x64/SDL2.dll" "$<TARGET_FILE_DIR:DigimonRA2>")
add_custom_target(package_release
    COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/package_release.py"
        --source "${CMAKE_CURRENT_SOURCE_DIR}" --binary-dir "$<TARGET_FILE_DIR:digimon_test>"
        --output "${CMAKE_CURRENT_SOURCE_DIR}/DigimonRA2_PC"
    DEPENDS DigimonRA2 digimon_test VERBATIM)
add_executable(portable_contracts src_test/portable_tests.cpp)
target_compile_definitions(portable_contracts PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
target_link_libraries(portable_contracts PRIVATE portable_support)
if(MSVC)
    target_compile_options(portable_contracts PRIVATE /O2 /W3 /utf-8)
endif()
add_test(NAME portable_contracts COMMAND portable_contracts)
add_executable(input_card_contracts src_test/input_card_tests.c src_test/input.c src_test/input_devices.c src_test/card_hle.c ${CPU_SOURCES})
target_link_libraries(input_card_contracts PRIVATE portable_support "${SDL2_DIR}/lib/x64/SDL2.lib")
if(MSVC)
    target_compile_options(input_card_contracts PRIVATE /O2 /W3 /wd4996)
endif()
add_custom_command(TARGET input_card_contracts POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${SDL2_DIR}/lib/x64/SDL2.dll" "$<TARGET_FILE_DIR:input_card_contracts>")
add_test(NAME input_card_contracts COMMAND input_card_contracts)
add_test(NAME package_release_contracts COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/package_release_tests.py")
